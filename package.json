{
  "name": "heybox-forum",
  "displayName": "HeyBox Forum",
  "description": "在 VSCode 中浏览小黑盒论坛帖子和评论，支持隐身模式",
  "version": "0.1.22",
  "publisher": "kyo",
  "repository": {
    "type": "git",
    "url": "https://github.com/WenfuRainbow/heybox.git"
  },
  "homepage": "https://github.com/WenfuRainbow/heybox#readme",
  "bugs": {
    "url": "https://github.com/WenfuRainbow/heybox/issues"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:heybox.postList",
    "onCommand:heybox.refreshList",
    "onCommand:heybox.searchPost",
    "onCommand:heybox.showReadingHistory",
    "onCommand:heybox.continueReading",
    "onCommand:heybox.goBack",
    "onCommand:heybox.goForward",
    "onCommand:heybox.openPost",
    "onCommand:heybox.openByUrl",
    "onCommand:heybox.loadMore",
    "onCommand:heybox.loadMoreSearch",
    "onCommand:heybox.loadMoreFeed",
    "onCommand:heybox.loadMoreFavourites",
    "onCommand:heybox.loadMoreMessages",
    "onCommand:heybox.switchToRecommend",
    "onCommand:heybox.switchToCategories",
    "onCommand:heybox.switchToFavorites",
    "onCommand:heybox.switchToMessages",
    "onCommand:heybox.selectMode",
    "onCommand:heybox.showMenu",
    "onCommand:heybox.login",
    "onCommand:heybox.logout",
    "onCommand:heybox.toggleFavourite",
    "onCommand:heybox.toggleNotifications",
    "onCommand:heybox.configureNotifications",
    "onCommand:heybox.markAllRead",
    "onCommand:heybox.openInBrowser",
    "onCommand:heybox.toggleSidebar",
    "onCommand:heybox.openClipboardUrl",
    "onCommand:heybox.switchTheme",
    "onWebviewPanel:heybox.postDetail"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "heybox",
          "title": "HeyBox",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "heybox": [
        {
          "id": "heybox.postList",
          "name": "帖子列表"
        },
        {
          "id": "heybox.postDetail",
          "name": "帖子详情",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "heybox.searchPost",
          "when": "view == heybox.postList || view == heybox.postDetail",
          "group": "navigation"
        },
        {
          "command": "heybox.goBack",
          "when": "view == heybox.postDetail",
          "group": "navigation"
        },
        {
          "command": "heybox.goForward",
          "when": "view == heybox.postDetail",
          "group": "navigation"
        },
        {
          "command": "heybox.refreshList",
          "when": "view == heybox.postList || view == heybox.postDetail",
          "group": "navigation"
        },
        {
          "command": "heybox.showMenu",
          "when": "view == heybox.postList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "heybox.openInBrowser",
          "when": "viewItem == post",
          "group": "0_inline"
        },
        {
          "command": "heybox.toggleFavourite",
          "when": "viewItem == post",
          "group": "0_inline"
        }
      ]
    },
    "commands": [
      {
        "command": "heybox.openPost",
        "title": "打开帖子",
        "category": "HeyBox"
      },
      {
        "command": "heybox.searchPost",
        "title": "搜索帖子",
        "icon": "$(search)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.exitSearch",
        "title": "返回话题列表",
        "category": "HeyBox"
      },
      {
        "command": "heybox.showReadingHistory",
        "title": "阅读历史",
        "category": "HeyBox"
      },
      {
        "command": "heybox.continueReading",
        "title": "继续阅读上次帖子",
        "category": "HeyBox"
      },
      {
        "command": "heybox.goBack",
        "title": "返回上一帖",
        "icon": "$(arrow-left)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.goForward",
        "title": "前进到下一帖",
        "icon": "$(arrow-right)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.switchToRecommend",
        "title": "切换到推荐",
        "category": "HeyBox"
      },
      {
        "command": "heybox.switchToCategories",
        "title": "切换到板块",
        "category": "HeyBox"
      },
      {
        "command": "heybox.switchToFavorites",
        "title": "切换到收藏",
        "category": "HeyBox"
      },
      {
        "command": "heybox.switchToMessages",
        "title": "切换到消息中心",
        "category": "HeyBox"
      },
      {
        "command": "heybox.selectMode",
        "title": "选择列表模式",
        "category": "HeyBox"
      },
      {
        "command": "heybox.showMenu",
        "title": "打开菜单",
        "icon": "$(ellipsis)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.loadMoreSearch",
        "title": "加载更多搜索结果",
        "category": "HeyBox"
      },
      {
        "command": "heybox.loadMoreFeed",
        "title": "加载更多推荐",
        "category": "HeyBox"
      },
      {
        "command": "heybox.loadMoreFavourites",
        "title": "加载更多收藏",
        "category": "HeyBox"
      },
      {
        "command": "heybox.loadMoreMessages",
        "title": "加载更多消息",
        "category": "HeyBox"
      },
      {
        "command": "heybox.refreshList",
        "title": "刷新列表",
        "icon": "$(refresh)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.toggleNotifications",
        "title": "切换消息提醒",
        "icon": "$(bell)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.configureNotifications",
        "title": "配置消息提醒分类",
        "category": "HeyBox"
      },
      {
        "command": "heybox.markAllRead",
        "title": "在小黑盒客户端标记消息已读",
        "icon": "$(check-all)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.openByUrl",
        "title": "通过URL打开帖子",
        "category": "HeyBox"
      },
      {
        "command": "heybox.openInBrowser",
        "title": "在浏览器中打开",
        "category": "HeyBox"
      },
      {
        "command": "heybox.toggleFavourite",
        "title": "收藏/取消收藏",
        "category": "HeyBox"
      },
      {
        "command": "heybox.loadMore",
        "title": "加载更多",
        "category": "HeyBox"
      },
      {
        "command": "heybox.toggleSidebar",
        "title": "切换侧边栏",
        "category": "HeyBox"
      },
      {
        "command": "heybox.openClipboardUrl",
        "title": "从剪贴板URL打开帖子",
        "category": "HeyBox"
      },
      {
        "command": "heybox.login",
        "title": "登录",
        "icon": "$(sign-in)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.logout",
        "title": "退出登录",
        "icon": "$(sign-out)",
        "category": "HeyBox"
      },
      {
        "command": "heybox.switchTheme",
        "title": "切换主题",
        "icon": "$(symbol-color)",
        "category": "HeyBox"
      }
    ],
    "keybindings": [
      {
        "command": "heybox.toggleSidebar",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      },
      {
        "command": "heybox.toggleSidebar",
        "key": "alt+h",
        "mac": "alt+h"
      },
      {
        "command": "heybox.openClipboardUrl",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter"
      }
    ],
    "walkthroughs": {
      "start": [
        {
          "id": "heybox.walkthrough",
          "title": "🐟 开始使用 HeyBox Forum",
          "description": "三步完成配置",
          "steps": [
            {
              "id": "setupCookie",
              "title": "1️⃣ 扫码登录",
              "description": "点击侧边栏登录按钮，使用小黑盒 App 扫描二维码并在手机上确认即可登录。登录凭证会自动保存到 VS Code 安全存储中。\n\n若扫码异常，可在扫码面板选择手动输入 Cookie 作为兼容兜底。",
              "completionEvents": [
                "onCommand:heybox.loginCompleted"
              ],
              "media": {
                "markdown": "resources/walkthrough-cookie.md"
              }
            },
            {
              "id": "browse",
              "title": "2️⃣ 浏览帖子",
              "description": "点击侧边栏 HeyBox 图标，展开话题查看帖子列表，或点击 🔍 搜索。点击帖子查看详情。",
              "completionEvents": [
                "onCommand:heybox.openPost"
              ],
              "media": {
                "markdown": "resources/walkthrough-browse.md"
              }
            },
            {
              "id": "stealth",
              "title": "3️⃣ 开启隐身模式",
              "description": "设置 ``heybox.stealthMode: true``，界面伪装为代码片段，适合办公环境。",
              "completionEvents": [
                "onSettingChanged:heybox.stealthMode"
              ],
              "media": {
                "markdown": "resources/walkthrough-stealth.md"
              }
            }
          ]
        }
      ]
    },
    "configuration": {
      "title": "HeyBox Forum",
      "properties": {
        "heybox.cookie": {
          "type": "string",
          "default": "",
          "description": "旧版手动 Cookie 兼容项：首次读取时会迁移至 VS Code 安全存储并清空此明文设置；退出后不会自动重新导入，建议使用扫码登录或登录菜单导入"
        },
        "heybox.deviceId": {
          "type": "string",
          "default": "",
          "description": "设备 ID（留空则自动生成并持久化）"
        },
        "heybox.proxy": {
          "type": "string",
          "default": "",
          "description": "HTTP/HTTPS 代理地址，例如 http://127.0.0.1:7890；留空则直接连接小黑盒"
        },
        "heybox.browserMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "node",
            "browser"
          ],
          "enumDescriptions": [
            "自动选择：检测到本机 Edge/Chrome 时使用浏览器通道，否则退回 Node 请求",
            "始终使用 Node 原生 HTTPS 请求",
            "始终使用本机 Edge/Chrome 浏览器通道"
          ],
          "description": "API 请求通道。小黑盒对 Node TLS 指纹存在风控时，建议使用浏览器通道"
        },
        "heybox.browserPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Edge/Chrome 可执行文件路径，例如 C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe；留空则自动查找"
        },
        "heybox.webVersion": {
          "type": "string",
          "default": "2.5",
          "description": "网页 API 兼容版本。仅在服务端兼容性变化时调整；留空则让服务端协商能力"
        },
        "heybox.heyboxId": {
          "type": "string",
          "default": "",
          "description": "小黑盒用户 ID（可留空，从 cookie 中自动提取）"
        },
        "heybox.stealthMode": {
          "type": "boolean",
          "default": false,
          "description": "隐身模式：将界面名称伪装为代码片段，Webview 标题显示为 README.md"
        },
        "heybox.minimalMode": {
          "type": "boolean",
          "default": false,
          "description": "简约模式：隐藏点赞/评论等社交数据，仅显示标题"
        },
        "heybox.postDetailLocation": {
          "type": "string",
          "default": "sidebar",
          "enum": [
            "sidebar",
            "editor",
            "beside"
          ],
          "enumDescriptions": [
            "在侧边栏/面板区域显示",
            "在编辑区显示",
            "在编辑区侧边显示"
          ],
          "description": "帖子详情显示位置"
        },
        "heybox.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "跟随 VSCode 主题",
            "强制暗色主题",
            "强制亮色主题"
          ],
          "description": "Webview 主题模式"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "npm run compile && npx @vscode/vsce package",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "test:unit": "node --test out/api/__tests__/*.test.js out/utils/__tests__/*.test.js",
    "test": "npm run compile && npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.57.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "parse5": "^7.3.0",
    "puppeteer-core": "^23.11.1",
    "qrcode": "^1.5.4"
  }
}
